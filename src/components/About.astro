---
import { education, site, skills } from "../data/content";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="folio about-grid">
    <p class="kicker">05 / About</p>
    <div class="about-main">
      <h2 id="about-title">A little <em>more.</em></h2>

      <div class="about-copy">
        {site.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="about-details">
        <section class="education" aria-labelledby="education-title">
          <p class="detail-label">Education</p>
          <h3 id="education-title">{education.school}</h3>
          <p>{education.degree}</p>
          <p>{education.period} · {education.detail}</p>
          <ul class="coursework" aria-label="Selected coursework">
            {
              education.coursework.map((course) => (
                <li>
                  <span>{course.code}</span>
                  <span>{course.title}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="skills-title">
          <p class="detail-label" id="skills-title">Skills</p>
          <dl class="skills-list">
            {
              skills.map((group) => (
                <div class="skills-row">
                  <dt>{group.label}</dt>
                  <dd>{group.items.join(" · ")}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>
    </div>
  </div>
</section>
