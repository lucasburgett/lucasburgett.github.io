---
import { experience } from "../data/content";
---

<section class="folio section" id="experience" aria-labelledby="experience-title">
  <h2 class="section-title" id="experience-title">Experience</h2>
  <p class="section-intro">
    From production computer vision to startup research and reinforcement learning for robots.
  </p>

  <div class="role-list">
    {
      experience.map((job) => (
        <article class="role">
          <p class="role__period">{job.period}</p>
          <div>
            <h3>{job.role}</h3>
            <p class="role__org">{job.org} · {job.location}</p>
            <p class="role__copy">
              {job.body}
              {job.tags && <span class="role__tags">{job.tags.join(" · ")}</span>}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>
