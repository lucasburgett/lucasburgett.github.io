---
import { site, socials } from "../data/content";

const github = socials.find((social) => social.label === "GitHub");
const linkedin = socials.find((social) => social.label === "LinkedIn");
const year = 2026;
---

<footer class="site-footer" id="contact">
  <div class="folio">
    <div class="site-footer__top">
      <p class="site-footer__name">{site.name}</p>
      <nav class="utility-links" aria-label="Contact links">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.resume} target="_blank">Résumé ↗</a>
        <a href={github?.href} target="_blank" rel="noopener">GitHub ↗</a>
        <a href={linkedin?.href} target="_blank" rel="noopener">LinkedIn ↗</a>
      </nav>
    </div>
    <p class="site-footer__meta">© {year} {site.name} · {site.location}</p>
  </div>
</footer>
