---
import { site, socials } from "../data/content";

const github = socials.find((social) => social.label === "GitHub");
const linkedin = socials.find((social) => social.label === "LinkedIn");
const year = 2026;
---

<footer class="closing" id="contact">
  <div class="folio closing__grid">
    <p class="kicker closing__note">06 / Contact</p>
    <div class="closing__main">
      <h2>The fastest way to reach me is <em>email.</em></h2>
      <p>{site.email}</p>
      <div class="closing__links">
        <a class="text-link" href={`mailto:${site.email}`}>{site.email} ↗</a>
        <a class="text-link" href={linkedin?.href} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="text-link" href={github?.href} target="_blank" rel="noopener">GitHub ↗</a>
        <a class="text-link" href={site.resume} target="_blank">Resume ↗</a>
      </div>
    </div>
  </div>

  <div class="folio footer">
    <span>© {year} {site.name} · {site.location}</span>
    <span>Math / Computer Science / Physical AI</span>
  </div>
</footer>
