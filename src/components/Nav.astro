---
import { site } from "../data/content";

const links = [
  { label: "Research", href: "#research" },
  { label: "Projects", href: "#projects" },
  { label: "Writing", href: "#writing" },
  { label: "Experience", href: "#experience" },
];
---

<header class="masthead">
  <div class="folio masthead__inner">
    <a class="wordmark" href="#top" aria-label={`${site.name}, home`}>{site.name}</a>
    <nav aria-label="Primary navigation">
      {links.map((link) => <a data-nav-link href={link.href}>{link.label}</a>)}
    </nav>
    <a class="header-contact" href={`mailto:${site.email}`}>Get in touch ↗</a>
  </div>
</header>
