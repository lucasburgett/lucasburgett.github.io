---
import { education, now, site, socials } from "../data/content";

const github = socials.find((social) => social.label === "GitHub");
const linkedin = socials.find((social) => social.label === "LinkedIn");
---

<section class="folio hero" id="top" aria-labelledby="hero-title">
  <div class="hero__edition">
    <p class="kicker">Portfolio / 2026</p>
    <p>{site.location}</p>
  </div>

  <h1 class="hero__headline" id="hero-title">
    <span>Lucas</span>
    <span>Burgett.</span>
  </h1>

  <div class="hero__intro">
    <p class="dek">{site.heroLead}</p>
    <p class="meta">{site.role} · {site.location}</p>
    <nav class="hero__links" aria-label="Profile links">
      <a class="text-link" href={site.resume} target="_blank">Resume ↗</a>
      <a class="text-link" href={github?.href} target="_blank" rel="noopener">GitHub ↗</a>
      <a class="text-link" href={linkedin?.href} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="text-link" href={`mailto:${site.email}`}>Email ↗</a>
    </nav>
  </div>

  <div class="hero__now">
    <article class="now-item">
      <p class="now-item__label">{now.summer.label} / Parametric ({now.summer.badge})</p>
      <h2>{now.summer.role}</h2>
      <p>{now.summer.detail}</p>
    </article>
    <article class="now-item">
      <p class="now-item__label">{now.research.label} / {now.research.org}</p>
      <h2>Research Assistant</h2>
      <p>{now.research.detail}</p>
    </article>
    <article class="now-item now-item--study">
      <p class="now-item__label">Study / Stanford</p>
      <h2>{education.school}</h2>
      <p>{education.degree}</p>
    </article>
  </div>
</section>
