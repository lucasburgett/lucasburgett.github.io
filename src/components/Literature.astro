---
import { literature } from "../data/content";
---

<section class="folio section" id="writing" aria-labelledby="writing-title">
  <header class="section-head">
    <p class="kicker">03 / Literature</p>
    <h2 id="writing-title">Writing on robotics <em>and evaluation.</em></h2>
  </header>

  <div class="writing-index">
    {
      literature.map((item) => (
        <article class="writing-story">
          <p class="writing-story__meta">
            <span>{item.published}</span>
            <span>{item.readTime}</span>
            <span>{item.publication}</span>
          </p>

          <div class="writing-story__content">
            <h3>{item.title}</h3>
            <p class="writing-story__summary">{item.summary}</p>
            <p class="writing-story__authors">{item.authors.join(" · ")}</p>
          </div>

          <a class="writing-story__action" href={item.href} target="_blank" rel="noopener">
            Read on {item.publication} ↗
          </a>
        </article>
      ))
    }
  </div>
</section>
