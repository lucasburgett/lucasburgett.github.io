---
import { literature } from "../data/content";

const leadStory = literature[0];
---

<section class="folio section" id="writing" aria-labelledby="writing-title">
  <header class="section-head">
    <p class="kicker">03 / Literature</p>
    <h2 id="writing-title">Writing on robotics <em>and evaluation.</em></h2>
  </header>

  <div class="writing-grid">
    <div class="writing-cover" aria-hidden="true">
      <p class="kicker">{leadStory?.publication ?? "Field notes"} / Journal 001</p>
      <span class="writing-cover__glyph">σ</span>
      <div class="writing-cover__foot">
        <span>Robot evaluation</span>
        <span>{leadStory?.published ?? "2026"}</span>
      </div>
    </div>

    <div class="writing-list">
      {
        literature.map((item) => (
          <article class="writing-story">
            <p class="publication">
              {item.publication} · {item.readTime} · {item.authors.join(" · ")}
            </p>
            <h3>{item.title}</h3>
            <p class="writing-story__summary">{item.summary}</p>
            <a class="text-link" href={item.href} target="_blank" rel="noopener">
              Read on {item.publication} ↗
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
