---
import { literature } from "../data/content";
---

<section class="folio section" id="writing" aria-labelledby="writing-title">
  <h2 class="section-title" id="writing-title">Writing</h2>

  <div class="entry-list">
    {
      literature.map((item) => (
        <article class="entry writing-entry">
          <div class="writing-entry__head">
            <h3>{item.title}</h3>
            <p class="entry-meta">{item.publication} · {item.published} · {item.readTime}</p>
          </div>
          <p class="entry-copy">{item.summary}</p>
          <p class="writing-entry__authors">{item.authors.join(" · ")}</p>
          <p class="entry-actions">
            <a href={item.href} target="_blank" rel="noopener">Read on {item.publication} ↗</a>
          </p>
        </article>
      ))
    }
  </div>
</section>
