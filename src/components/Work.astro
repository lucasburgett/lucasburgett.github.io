---
import { work } from "../data/content";

const featured = work.find((item) => item.featured);
const projects = work.filter((item) => !item.featured);
---

{
  featured && (
    <section class="feature" id="research" aria-labelledby="research-title">
      <div class="folio">
        <header class="feature__top">
          <p class="kicker">01 / Featured research</p>
          <h2 class="feature__title" id="research-title">
            VLA <span>Memory</span>
          </h2>
          <p class="feature__status">
            <span>{featured.inProgress ? "In progress" : "Featured project"}</span>
            <br />
            <span>Robot learning</span>
            <br />
            <span>2026</span>
          </p>
        </header>

        <div class="feature__spread">
          <div class="feature__abstract">
            {featured.tagline && <p class="feature__lead">{featured.tagline}.</p>}
            <p class="feature__body">{featured.body}</p>
            {featured.href && (
              <a class="text-link" href={featured.href} target="_blank" rel="noopener">
                {featured.hrefLabel ?? "View source"} ↗
              </a>
            )}
          </div>

          {featured.media && (
            <figure class="research-figure">
              <div class="research-figure__frame">
                <video
                  controls
                  preload="none"
                  playsinline
                  poster={featured.media.poster}
                  aria-label={featured.media.caption}
                >
                  <source src={featured.media.src} type="video/mp4" />
                </video>
                <span class="research-figure__mark">RoboMME / Evaluation rollout</span>
              </div>
              <figcaption>
                <strong>Fig. 01</strong>
                <span>{featured.media.caption}</span>
              </figcaption>
            </figure>
          )}

          {featured.highlights && (
            <dl class="feature__notes">
              {featured.highlights.map((highlight, index) => (
                <div class="feature__note">
                  <dt>{String(index + 1).padStart(2, "0")} / Research note</dt>
                  <dd>{highlight}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>
  )
}

<section class="folio section" id="projects" aria-labelledby="projects-title">
  <header class="section-head">
    <p class="kicker">02 / Projects &amp; Personal Research</p>
    <h2 id="projects-title">Research and projects, <em>in and out of class.</em></h2>
  </header>

  <div class="project-index">
    {
      projects.map((item, index) => (
        <article class="project">
          <div class="project__identity">
            <span class="project__number">P—{String(index + 1).padStart(2, "0")}</span>
            <h3 class="project__title">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noopener">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
          </div>

          <div class="project__copy">
            {item.tagline && <p class="project__tagline">{item.tagline}</p>}
            <p>{item.body}</p>
            {item.highlights && (
              <ul class="project__highlights">
                {item.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            )}
          </div>

          <p class="project__stack">
            {item.tags.map((tag) => <span>{tag}</span>)}
            {item.repoNote && <span class="project__repo">{item.repoNote}</span>}
          </p>

          {item.href ? (
            <a
              class="project__action"
              href={item.href}
              target="_blank"
              rel="noopener"
              aria-label={`${item.hrefLabel ?? "View source"} for ${item.title}`}
            >
              ↗
            </a>
          ) : (
            <span class="project__action" aria-hidden="true">—</span>
          )}
        </article>
      ))
    }
  </div>
</section>
