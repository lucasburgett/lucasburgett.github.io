---
import { work } from "../data/content";
---

<section class="folio section" id="projects" aria-labelledby="projects-title">
  <span class="anchor-alias" id="research" aria-hidden="true"></span>
  <h2 class="section-title" id="projects-title">Projects &amp; Personal Research</h2>

  <div class="entry-list">
    {
      work.map((item) => (
        <article class={`entry project-entry${item.featured ? " project-entry--research" : ""}`}>
          <h3>
            {item.href && !item.featured ? (
              <a href={item.href} target="_blank" rel="noopener">{item.title}</a>
            ) : (
              item.title
            )}
          </h3>
          {item.featured && (
            <p class="entry-meta">
              {item.inProgress ? "In progress" : "Research project"} · Robot learning · 2026
            </p>
          )}
          {item.tagline && <p class="entry-tagline">{item.tagline}</p>}
          <p class="entry-copy">{item.body}</p>
          {item.media && (
            <figure class="research-figure">
              <div class="research-figure__frame">
                <video
                  controls
                  preload="none"
                  playsinline
                  poster={item.media.poster}
                  aria-label={item.media.caption}
                >
                  <source src={item.media.src} type="video/mp4" />
                </video>
              </div>
              <figcaption>Evaluation rollout · {item.media.caption}</figcaption>
            </figure>
          )}
          {item.highlights && !item.featured && (
            <ul class="entry-highlights">
              {item.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          )}
          <p class="entry-tags">{item.tags.join(" · ")}</p>
          <p class="entry-actions">
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener">
                {item.hrefLabel ?? "View source"} ↗
              </a>
            ) : (
              <span class="entry-meta">{item.repoNote}</span>
            )}
          </p>
        </article>
      ))
    }
  </div>
</section>
